# ── TutoApp .gitignore ──────────────────────────────────────────────────
# QUÉ EXCLUIMOS: archivos privados y generados automáticamente.
# El servidor SÍ sube a git para que el proyecto funcione en cualquier equipo.
# Lo que NUNCA sube: keys de API (.env) y paquetes instalados (.venv/).

# --- CREDENCIALES Y LLAVES DE ACCESO ---
.env
.env.local
.env.*
!.env.example
!server/.env.example
server/.env
*.pem
*.key
*.cert
secret_*
credentials.json

# --- CONFIGURACIONES DE CLAUDE CODE Y CONFIGS LOCALES ---
.claude/
.claude_settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- ARCHIVOS DEL SISTEMA OPERATIVO (Basura del PC) ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# --- ENTORNOS VIRTUALES Y DEPENDENCIAS (No se deben subir) ---
node_modules/
bower_components/
venv/
.venv/
env/
__pycache__/
*.pyc
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ── Herramientas de desarrollo local (no van al repo) ────────────────────
client/.playwright-mcp/
front/
