# ── TutoApp Backend — Variables de entorno ──────────────────────────────
# Copiá este archivo como .env y completá las keys que quieras usar.
# El .env NUNCA sube a git (ver .gitignore).
#
# Puter.js es el proveedor default — funciona SIN ninguna key aquí.
# Solo completá lo que necesitás usar además de Puter.
# ────────────────────────────────────────────────────────────────────────

# Claude (Anthropic) — console.anthropic.com/settings/keys
# Sin esto, la opción Claude en los HTML queda deshabilitada desde el proxy.
ANTHROPIC_API_KEY=

# Google Gemini — aistudio.google.com (gratis, sin tarjeta de crédito)
GEMINI_API_KEY=

# Ollama — URL del servidor local (default: localhost:11434)
# Solo cambiá si tenés Ollama en otro puerto.
OLLAMA_URL=http://localhost:11434
